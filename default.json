{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":disableDependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:openssf-scorecard",
    "mergeConfidence:all-badges"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "before 6am"
  ],
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  "configMigration": true,
  "hostRules": [
    {
      "matchHost": "github.com",
      "token": "{{ secrets.RENOVATE_GITHUB_COM_TOKEN }}"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "GitHub Actions: one PR for all non-major + digest bumps, auto-merged daily, chore(ci) scope.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci",
      "automerge": true
    },
    {
      "description": "Per-ecosystem non-major grouping for stable (>=1.0) deps; 0.x stays individual so a breaking 0.x bump never blocks the batch.",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "gomod (non-major)"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "cargo (non-major)"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "npm (non-major)"
    },
    {
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "poetry",
        "pip-compile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "groupName": "python (non-major)"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "docker (non-major)"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit (non-major)"
    },
    {
      "description": "Auto-merge patches, digest re-pins, and initial pins (docker index digests are multi-arch safe).",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Auto-merge minor updates, 0.x included (for example 0.22 -> 0.23). CI must pass first, and a breaking 0.x change usually fails the build. Majors stay reviewable in the queue.",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Move each caller's claude-review.yml pin to schubydoo/shared-workflows on the next hourly run, not in the before-6am window. Its own group takes it out of the github-actions group, whose schedule would hold it. A change to the shared workflow is reviewed in the shared-workflows repo before it reaches main, and the callers' checks never run the review workflow, so a nightly wait adds no safety. It is a digest update, so the soak in lodger and scratchsmith already exempts it.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "schubydoo/shared-workflows"
      ],
      "groupName": "shared-workflows",
      "schedule": [
        "at any time"
      ],
      "automerge": true
    }
  ]
}
